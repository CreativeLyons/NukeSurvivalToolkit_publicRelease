Group {
 name apGlow
 help "apeGlow v1.0 - apEssentials by Adrian Pueyo\n\nExponential glow with advanced controls, using the traditional multi-blur approach.\n\nWith the \"area\" input (optional) you can set only a part of the image to emit glow.\nNaN's will be turned black, on rgba only.\n\nadrianpueyo.com, 2015-2019."
 onCreate "n = nuke.thisNode()\nfor i in \['intensity','response','max_size','src_black','src_white','response'\]:\n    n\[i\].setFlag(0x00000004)\nn\['max_size'\].setRange(0,10000)\nn\['overscan'\].setRange(0,1000)\n# Keep the inline DAG view off without writing a newer-version knob to .nk.\nif n.knob(\"disable_group_view\") is not None:\n    n\[\"disable_group_view\"\].setValue(True)\n    n\[\"disable_group_view\"\].setFlag(nuke.DO_NOT_WRITE)"
 knobChanged "def _apglow_knob_changed():\n    import nuke\n    import re\n\n    n = nuke.thisNode()\n    k = nuke.thisKnob()\n    if k.name() in (\"crop\", \"enableOverscan\"):\n        crop = n\[\"crop\"\].value()\n        overscan = n\[\"enableOverscan\"\].value()\n        n\[\"enableOverscan\"\].setEnabled(not crop)\n        n\[\"overscan\"\].setEnabled(not crop and overscan)\n        return\n    if k.name() != \"s\":\n        return\n\n    steps = max(1, int(k.value()))\n    data = n.node(\"DP\")\n    merge = n.node(\"MergeBlurs\")\n    first_blur = n.node(\"Blur0\")\n    if data is None or merge is None or first_blur is None:\n        return\n\n    def expression(knob, index=0):\n        curve = knob.animation(index)\n        return \"\".join(curve.expression().split()) if curve is not None else \"\"\n\n    def generated_pair(mult):\n        if mult is None or mult.Class() != \"Multiply\" or merge.input(2) == mult:\n            return None\n        match = re.fullmatch(r\"Multiply(\[1-9\]\[0-9\]*)\", mult.name())\n        blur = mult.input(0)\n        if (match is None or blur is None or blur.Class() != \"Blur\"\n                or blur.name() != \"Blur\" + match.group(1) or blur.input(0) != data):\n            return None\n        # Topology alone is not ownership: retain user-authored/customized\n        # branches unless the names and generated expressions also match.\n        for index in range(2):\n            size = re.fullmatch(r\"DP\\.j\\(\\(1/parent\\.s\\)\\*(\[0-9\]+)\\)/parent\\.f\",\n                                expression(blur\[\"size\"\], index))\n            if size is None or int(size.group(1)) < 2:\n                return None\n        for knob in (\"filter\", \"quality\"):\n            if expression(blur\[knob\]) != first_blur.name() + \".\" + knob:\n                return None\n        for index in range(mult\[\"value\"\].arraySize()):\n            value = re.fullmatch(r\"parent\\.p\\*(\[0-9.eE-\]+)\\+(\[0-9.eE-\]+)\",\n                                 expression(mult\[\"value\"\], index))\n            if value is None:\n                return None\n            try:\n                weight, offset = (float(part) for part in value.groups())\n            except ValueError:\n                return None\n            if not (0 <= weight <= 1 and 0 <= offset <= 1\n                    and abs(weight + offset - 1) < 1e-6):\n                return None\n        # Shared nodes are customized state; deleting them would rewire their users.\n        flags = nuke.INPUTS | nuke.HIDDEN_INPUTS | nuke.EXPRESSIONS\n        for owned, allowed in ((blur, mult), (mult, merge)):\n            if any(dependent != allowed for dependent in\n                   nuke.dependentNodes(flags, \[owned\], True)):\n                return None\n        return blur\n\n    # Preserve the parser's complete Tcl input stack, including empty inputs.\n    saved_stack = nuke.tcl(\"stack\") or \"\"\n    selected_names = {child.name() for child in n.nodes() if child.isSelected()}\n    undo = nuke.Undo()\n    undo.disable()\n    try:\n        # Normalize the step value in the same undo scope as its derived graph.\n        if k.value() != steps:\n            k.setValue(steps)\n        with n:\n            branches = {}\n            for index in range(1, merge.inputs()):\n                mult = merge.input(index)\n                blur = generated_pair(mult)\n                if blur is not None:\n                    branches\[mult\] = blur\n                    merge.setInput(index, None)\n            # A generated branch can feed several Merge inputs. Delete it once.\n            for mult, blur in branches.items():\n                nuke.delete(mult)\n                nuke.delete(blur)\n            for index in range(1, steps):\n                suffix = index\n                while n.node(\"Blur%s\" % suffix) or n.node(\"Multiply%s\" % suffix):\n                    suffix += 1\n                blur = nuke.nodes.Blur(name=\"Blur%s\" % suffix, inputs=\[data\])\n                blur.setXYpos(first_blur.xpos() + index * 100, first_blur.ypos())\n                blur\[\"channels\"\].setValue(\"all\")\n                for knob in (\"filter\", \"quality\"):\n                    blur\[knob\].setExpression(first_blur.name() + \".\" + knob)\n                blur\[\"crop\"\].setValue(0)\n                blur\[\"size\"\].setValue(\[0, 0\])\n                blur\[\"size\"\].setExpression(\"DP.j((1/parent.s)*%s)/ parent.f\" % (index + 1))\n                mult = nuke.nodes.Multiply(name=\"Multiply%s\" % suffix, inputs=\[blur\])\n                mult.setXYpos(first_blur.xpos() + index * 100, first_blur.ypos() + 38)\n                mult\[\"channels\"\].setValue(\"all\")\n                mult\[\"value\"\].setValue(\[0, 0, 0, 0\])\n                mult\[\"value\"\].setExpression(\"parent.p*%s+%s\" % ((index + 1) / steps,\n                                                              1 - (index + 1) / steps))\n                port = index if index < 2 else index + 1\n                # Leave custom inputs and the mask input (2) in place.\n                while port == 2 or merge.input(port) is not None:\n                    port += 1\n                merge.setInput(port, mult)\n    finally:\n        try:\n            for child in n.nodes():\n                child.setSelected(child.name() in selected_names)\n            nuke.tcl(\"pop\", str(nuke.tcl(\"llength\", nuke.tcl(\"stack\") or \"\") or 0))\n            for index in reversed(range(int(nuke.tcl(\"llength\", saved_stack) or 0))):\n                item = nuke.tcl(\"lindex\", saved_stack, str(index)) or \"0\"\n                if item == \"0\" or nuke.exists(item):\n                    nuke.tcl(\"push\", item)\n        finally:\n            undo.enable()\n\n\ntry:\n    _apglow_knob_changed()\nfinally:\n    globals().pop(\"_apglow_knob_changed\", None)\n"
 tile_color 0xe88543ff
 selected true
 addUserKnob {20 apeGlow}
 addUserKnob {41 channels T KeepWhat.channels}
 addUserKnob {7 intensity t "Intensity multiplier for the resulting glow." R 0 10}
 intensity 1
 addUserKnob {18 p l persistance t "Color gain of the largest step. Affects the other steps progressively, with the least effect on the smallest one.\n\nUse as an inverse falloff or as a progressive color tint." R 0 10}
 p 1
 addUserKnob {6 p_panelDropped l "panel dropped state" -STARTLINE +HIDDEN}
 addUserKnob {18 tint t "Overall color multiplier for the intensity."}
 tint 1
 addUserKnob {6 tint_panelDropped l "panel dropped state" -STARTLINE +HIDDEN}
 addUserKnob {6 effect_only l "effect only" +STARTLINE}
 effect_only true
 addUserKnob {26 ""}
 addUserKnob {7 src_black l "src black" t "Black point of the source image's luminance.\nClip the effect below this luminance value." R 0 4}
 addUserKnob {7 src_white l "src white" t "White point of the source image's luminance." R 0 4}
 src_white 1
 addUserKnob {41 white_clamp l clamp -STARTLINE T Grade1.white_clamp}
 addUserKnob {7 response t "Gamma on the source image's luminance, to change the response curve falloff." R 0 4}
 response 1
 addUserKnob {26 ""}
 addUserKnob {14 max_size l "max size" t "Maximum pixel size of the exponential glow." R 0 10000}
 max_size 2000
 addUserKnob {14 f l "size falloff" t "Falloff adjustment on the exponential distribution of the blur sizes.\n\nReduce this to have the glow more diffuse (starting with larger blurs).\nIncrease to have the glow tighter and more defined (start with smaller blurs)." R 0 10}
 f 1
 addUserKnob {3 s l steps t "Number of blur iterations to combine together."}
 s 10
 addUserKnob {41 filter T Blur0.filter}
 addUserKnob {41 quality l "" -STARTLINE T Blur0.quality}
 addUserKnob {6 crop l "crop to format" -STARTLINE}
 addUserKnob {14 overscan R 0 1000}
 overscan 100
 addUserKnob {6 enableOverscan l enable -STARTLINE}
 enableOverscan true
 addUserKnob {26 ""}
 addUserKnob {41 maskChannelArea l area -STARTLINE T ExpressionArea.maskChannelMask}
 addUserKnob {41 inject_area l inject -STARTLINE T ExpressionArea.inject}
 addUserKnob {41 invert_area l invert -STARTLINE T ExpressionArea.invert_mask}
 addUserKnob {41 fringe_area l fringe -STARTLINE T ExpressionArea.fringe}
 addUserKnob {41 maskChannelMask l mask T Merge.maskChannelMask}
 addUserKnob {41 inject -STARTLINE T Merge.inject}
 addUserKnob {41 invert_mask l invert -STARTLINE T Merge.invert_mask}
 addUserKnob {41 fringe -STARTLINE T Merge.fringe}
 addUserKnob {41 mix T Merge.mix}
 addUserKnob {26 version_author l "" t "apeGlow v1.0\n2019" +STARTLINE T "<span style=\"color:#666\"><br/><b>apeGlow v1.0</b> - <a href=\"http://www.adrianpueyo.com\" style=\"color:#666;text-decoration: none;\">adrianpueyo.com</a>, 2015-2019</span>"}
}
